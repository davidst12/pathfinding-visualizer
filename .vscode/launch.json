{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run Main",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/Pathfinding", // Ruta al ejecutable generado
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "lldb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],      
        "preLaunchTask": "build"
      }
    ],
    "debug.defaultConfiguration": "Run Main"
  }