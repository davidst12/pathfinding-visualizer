// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
	"name": "C++",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y libx11-dev libxrandr-dev libxcursor-dev libxi-dev libudev-dev libgl1-mesa-dev",
	"features": {
		"ghcr.io/devcontainers/features/desktop-lite:1": {
			"screenResolution": "1280x720x32"
		}
	},
	"containerEnv": {
		"DISPLAY": ":1",
		"VNC_RESOLUTION": "1280x720x32",
		"VNC_COLORDY": "32"
	},
    "forwardPorts": [6080],
    "portsAttributes": {
        "6080": {
            "label": "Desktop Lite Web"
        }
    },
    "runArgs": ["--init"]
}
